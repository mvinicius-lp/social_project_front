    "eslint-plugin-oxlint": "~1.29.0",
    "eslint-plugin-vue": "~10.5.1",
    "globals": "^16.5.0",
    "json-server": "^1.0.0-beta.3",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.29.0",
